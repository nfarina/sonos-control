<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Entitlements applied at distribution sign-time. Sandbox is disabled
         (we need raw UDP for SSDP discovery), so this set is minimal — just
         the get-task-allow flag turned off as notarization requires. -->
    <key>com.apple.security.get-task-allow</key>
    <false/>
</dict>
</plist>
